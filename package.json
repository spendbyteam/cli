{
  "name": "spendbyteam",
  "version": "0.4.0",
  "description": "See what Claude Code costs per project, model, branch or day (offline), and connect it to SpendByTeam for your team.",
  "license": "MIT",
  "homepage": "https://spendbyteam.com/docs/install",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spendbyteam/cli.git"
  },
  "bugs": {
    "email": "support@spendbyteam.com"
  },
  "type": "module",
  "bin": {
    "spendbyteam": "dist/cli.js"
  },
  "files": [
    "dist",
    "hook/hook.sh",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:hook",
    "test:unit": "vitest run",
    "test:hook": "bash test/hook.test.sh",
    "prepublishOnly": "npm run build && npm test",
    "web-shell": "npm run build && node scripts/web-shell.mjs"
  },
  "keywords": [
    "claude-code",
    "opentelemetry",
    "cost",
    "usage",
    "tokens",
    "spendbyteam"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
